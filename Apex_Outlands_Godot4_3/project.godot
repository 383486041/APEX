; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="APEX 英雄：外域协议 (Godot 4.3 Pro Edition)"
config/description="Complete 3D Apex Legends Tribute in Godot 4.3 with Authentic Optics ADS, Cumulative Screen Damage Readout, Armor/Flesh/Crack Audio, Articulated Melee Hands, Smart Enemy AI, Supply Bins & Loot Ticks"
run/main_scene="res://scenes/MainLobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameData="*res://autoload/GameData.gd"
PlayerState="*res://autoload/PlayerState.gd"
AudioSynthesizer="*res://autoload/AudioSynthesizer.gd"
BehaviorRecorder="*res://autoload/BehaviorRecorder.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
